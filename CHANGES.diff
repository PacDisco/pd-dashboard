+        ON CONFLICT (submission_id, file_url) DO UPDATE
+          SET instructor_id = COALESCE(instructor_documents.instructor_id, EXCLUDED.instructor_id),
+              doc_type      = EXCLUDED.doc_type
+        RETURNING id`;
+      if (r.length) n++;
+    } catch (e) { /* skip a bad row, keep syncing */ }
+  }
+  return n;
+}
